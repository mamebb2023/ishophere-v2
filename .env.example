# Supabase credentials (safe for the browser — RLS protects your data)
# Copy this file to .env.local and fill in your project values.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Server-only key, used by `npm run seed:owner`.
# Never prefix it with VITE_ and never expose it in the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
